NODE_ENV=development
LOG_LEVEL=info

MONGODB_URI=mongodb://localhost:27017/arivu-inbound
REDIS_URL=redis://localhost:6379

# OCI Object Storage (S3-compatible API)
# Console: Storage → Buckets → your bucket
# Customer Secret Keys: User menu → Customer secret keys
# Endpoint format: https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
STORAGE_ENDPOINT=https://YOUR_NAMESPACE.compat.objectstorage.us-phoenix-1.oraclecloud.com
STORAGE_REGION=us-phoenix-1
STORAGE_ACCESS_KEY="your-oci-access-key-id"
STORAGE_SECRET_KEY="your-oci-secret-access-key"
STORAGE_BUCKET=arivu-inbound
STORAGE_FORCE_PATH_STYLE=true

SMTP_HOST=0.0.0.0
SMTP_PORT=2525
SMTP_DOMAIN=reply.arivusystems.com

API_HOST=0.0.0.0
API_PORT=3000

# Admin UI (pnpm prod:ui:up) — leave unset to use /api proxy via vite preview (recommended)
# Only set if UI and API are on different hosts without a reverse proxy:
# VITE_API_URL=https://parser.example.com

# CRM webhook (optional — event-dispatcher logs to stdout when unset)
# CRM_WEBHOOK_URL=https://crm.example.com/webhooks/inbound-email
# CRM_WEBHOOK_SECRET=your-shared-hmac-secret

# CRM → parser provisioning (POST /integrations/v1/mailboxes) — required in production
# CRM_API_KEY=your-long-random-api-key-min-32-chars

# Phase 4 — Security (SMTP edge + auth)
SECURITY_AUTH_MODE=off
# SECURITY_AUTH_MODE=monitor
# SECURITY_AUTH_MODE=enforce
SECURITY_RATE_LIMIT_IP_PER_MIN=120
SECURITY_RATE_LIMIT_TENANT_PER_MIN=300
# SECURITY_IP_ALLOWLIST=203.0.113.10,198.51.100.0
# SECURITY_IP_BLOCKLIST=
# SECURITY_GREYLIST_ENABLED=false
# SECURITY_GREYLIST_TTL_SEC=300
# SMTP_TLS_ENABLED=false
# SMTP_TLS_KEY_PATH=/path/to/key.pem
# SMTP_TLS_CERT_PATH=/path/to/cert.pem

# Queue retries (BullMQ)
QUEUE_MAX_ATTEMPTS=3
QUEUE_BACKOFF_MS=2000

# Shared log file for admin Logs page (default: logs/arivu.log). Set LOG_FILE=false to disable.
# LOG_FILE=/path/to/arivu.log

# Production seed (pnpm prod:seed -- --tenant-id t_acme --mailbox-id m_support)
# SEED_TENANT_ID=t_acme
# SEED_MAILBOX_ID=m_support
# SEED_TENANT_NAME=Acme Inc
# SEED_MAILBOX_NAME=Support
# SEED_ROUTING_LOCAL=support
# SEED_MAILBOX_TYPE=shared

# See docs/PRODUCTION-DEPLOYMENT.md for full production checklist

MAX_ATTACHMENT_BYTES=26214400
MAX_MESSAGE_BYTES=52428800
STREAM_CHUNK_BYTES=65536
