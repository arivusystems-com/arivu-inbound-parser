    "test": "pnpm build && tsc -p tsconfig.test.json && node --test dist/index.test.js"
  },
  "dependencies": {
    "@arivu/database": "workspace:*",
    "@arivu/types": "workspace:*",
    "ulid": "^2.3.0"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
