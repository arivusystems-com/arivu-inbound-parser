{
  "name": "arivu-inbound-parser",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant inbound email parser for Arivu CRM",
  "scripts": {
    "build": "pnpm -r run build",
    "build:prod": "bash scripts/build-prod.sh",
    "pack:server": "bash scripts/pack-for-server.sh",
    "dev": "pnpm -r --parallel run dev",
    "dev:core": "pnpm --filter \"./packages/*\" run build && pnpm --parallel --filter @arivu/api --filter @arivu/smtp-server --filter @arivu/parser-worker --filter @arivu/attachment-worker --filter @arivu/event-dispatcher run dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r run typecheck",
    "clean": "pnpm -r run clean && rm -rf node_modules",
    "seed": "tsx scripts/seed.ts",
    "storage:check": "tsx scripts/check-storage.ts",
    "test": "pnpm --filter @arivu/routing build && tsc -p packages/routing/tsconfig.test.json && node --test packages/routing/dist/index.test.js",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:ps": "docker compose ps",
    "dev:stop": "bash scripts/dev-stop.sh",
    "prod:check": "bash scripts/prod-check.sh",
    "prod:seed": "bash scripts/prod-seed.sh",
    "prod:up": "bash scripts/prod-up.sh",
    "prod:ui:up": "bash scripts/prod-ui-up.sh",
    "prod:ui:down": "bash scripts/prod-ui-down.sh",
    "prod:down": "bash scripts/prod-down.sh",
    "prod:status": "bash scripts/prod-status.sh",
    "prod:diagnose": "bash scripts/prod-diagnose.sh",
    "prod:infra:up": "docker compose -f docker-compose.prod.yml up -d",
    "prod:infra:down": "docker compose -f docker-compose.prod.yml down"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@arivu/config": "workspace:*",
    "@arivu/database": "workspace:*",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "@types/node": "^22.10.5",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0"
}
