{
  "name": "@arivu/smtp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@arivu/config": "workspace:*",
    "@arivu/database": "workspace:*",
    "@arivu/logger": "workspace:*",
    "@arivu/queue": "workspace:*",
    "@arivu/routing": "workspace:*",
    "@arivu/storage": "workspace:*",
    "@arivu/types": "workspace:*",
    "smtp-server": "^3.13.6",
    "ulid": "^2.3.0"
  },
  "devDependencies": {
    "@types/smtp-server": "^3.5.12",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
